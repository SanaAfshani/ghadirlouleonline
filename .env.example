# ─── Vercel / production ───────────────────────────────────────────────────
# 1. Create a free DB: https://neon.tech
# 2. Copy the real "Pooled connection" string (host looks like ep-abc123-...-pooler....neon.tech)
# 3. Paste ONLY in Vercel → Settings → Environment Variables (NOT in this file)
DATABASE_URL=

JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── پیامک (ملی پیامک) — فقط در تنظیمات سرور، نه در این فایل ────────────────────
# نام کاربری پنل و کلید وب‌سرویس (توسعه دهندگان ← وب سرویس & API). بدون این دو پیامکی ارسال نمی‌شود.
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# موبایل(های) مدیر برای خبر درخواست جدید، با کاما. خالی = موبایل تنظیمات سایت
SMS_ADMIN_MOBILE=
