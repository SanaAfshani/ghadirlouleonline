# ─── Vercel / production ───────────────────────────────────────────────────
# 1. Create a free DB: https://neon.tech
# 2. Copy the real "Pooled connection" string (host looks like ep-abc123-...-pooler....neon.tech)
# 3. Paste ONLY in Vercel → Settings → Environment Variables (NOT in this file)
DATABASE_URL=

JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── پیامک (کاوه‌نگار) — فقط در تنظیمات سرور، نه در این فایل ────────────────────
# کلید API از پنل کاوه‌نگار: توسعه دهندگان ← کلید API. بدون آن پیامکی ارسال نمی‌شود.
KAVENEGAR_API_KEY=
# موبایل(های) مدیر برای خبر درخواست جدید، با کاما. خالی = موبایل تنظیمات سایت
SMS_ADMIN_MOBILE=
