generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  avatar    String?
  posts     BlogPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  order       Int        @default(0)
  published   Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?
  price            Float?
  images           String   @default("[]")
  specifications   String   @default("{}")
  inStock          Boolean  @default(true)
  featured         Boolean  @default(false)
  published        Boolean  @default(true)

  // --- فیلدهای سئو (همه اختیاری؛ خالی باشند از نام/توضیح کوتاه محصول fallback می‌شود) ---
  metaTitle        String?
  metaDescription  String?
  focusKeyword     String?
  ogTitle          String?
  ogDescription    String?
  /** سوالات متداول اختصاصی محصول — آرایه JSON از {question, answer} */
  faqs             String   @default("[]")
  /** کاتالوگ‌ها و مدارک فنی محصول — آرایه JSON از {title, url} */
  catalogs         String   @default("[]")
  /** ردیف‌های تابلوی قیمت لحظه‌ای این محصول */
  priceItems       PriceItem[]
  /// قیمت روز هر کیلوگرم (تومان). وقتی پر است قیمت هر ردیفِ وزن‌دار = وزن × این عدد و دستی وارد نمی‌شود.
  pricePerKg       Int?
  /// منسوخ — جایگزین آن جدول PriceItem است و کد جدید آن را نمی‌خواند.
  /// فقط نگه داشته شده تا نسخه قبلی سایت (اگر روی سرور است) با نبود ستون خطا ندهد؛ بعد از دیپلوی نسخه جدید قابل حذف است.
  priceList        String   @default("[]")

  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String?
  content    String
  coverImage String?
  pdfUrl     String?
  tags       String   @default("[]")
  published  Boolean  @default(false)
  featured   Boolean  @default(false)
  readTime   Int      @default(5)
  viewCount  Int      @default(0)

  // --- فیلدهای سئو (همه اختیاری؛ خالی باشند از عنوان/خلاصه مقاله fallback می‌شود) ---
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogTitle         String?
  ogDescription   String?
  /** سوالات متداول اختصاصی مقاله — آرایه JSON از {question, answer} */
  faqs            String  @default("[]")

  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  content     String?
  /** آرایه JSON از {url, alt} — ردیف‌های قدیمی آرایه ساده رشته‌اند و موقع خواندن نرمال می‌شوند */
  images      String   @default("[]")
  location    String?
  year        Int
  client      String?
  published   Boolean  @default(true)
  featured    Boolean  @default(false)

  // --- فیلدهای سئو (همه اختیاری؛ خالی باشند از عنوان/توضیح پروژه fallback می‌شود) ---
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogTitle         String?
  ogDescription   String?
  /** سوالات متداول اختصاصی پروژه — آرایه JSON از {question, answer} */
  faqs            String  @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  position  String?
  content   String
  rating    Int      @default(5)
  avatar    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String
  type  String @default("text")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  /// صفحه‌ای که فرم از آن ارسال شد — برای اینکه بدانیم کدام صفحه مشتری می‌آورد
  sourcePath String?
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

/// تماس‌ها و درخواست‌های مشتری برای گزارش «کدام صفحه مشتری می‌آورد»:
/// کلیک روی تلفن یا واتس‌اپ (از مرورگر) و ارسال فرم مشاوره/تماس (از سرور)
model LeadEvent {
  id        String   @id @default(cuid())
  /// phone | whatsapp | form
  type      String
  /// صفحه‌ای که اقدام در آن انجام شد
  path      String
  /// شماره یا لینک کلیک‌شده؛ برای فرم، موضوع آن
  target    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

/// آدرس‌های قدیمی که به آدرس جدید منتقل شده‌اند (ریدایرکت دائمی).
/// با تغییر اسلاگ در پنل ادمین خودکار ثبت می‌شود تا لینک‌های قبلی و رتبه گوگل از بین نرود.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  createdAt DateTime @default(now())
}

/// ردیف تابلوی قیمت لحظه‌ای — هر ردیف یک سایز/مدل از یک محصول.
/// جدول مستقل (نه JSON داخل محصول) تا هر قیمت جدا و همزمان قابل ویرایش باشد و قیمت قبلی برای نمایش تغییر نگه داشته شود.
model PriceItem {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title          String
  /// قیمت به تومان؛ null یعنی «استعلام»
  price          Int?
  /// قیمت قبل از آخرین تغییر — برای فلش بالا/پایین و درصد تغییر
  previousPrice  Int?
  /// مشخصات جدا از عنوان — title فقط «مدل» است؛ نام کامل ردیف از کنار هم گذاشتن این‌ها ساخته می‌شود
  size           String   @default("")
  /// کلاس وزنی: سبک / نیمه‌سنگین / سنگین — ترتیب مرتب‌سازی در price-item.ts
  grade          String   @default("")
  spec           String   @default("")
  dimensions     String   @default("")
  weight         String   @default("")
  note           String   @default("")
  sortOrder      Int      @default(0)
  priceChangedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  history        PriceHistory[]

  @@index([productId, sortOrder])
  @@index([updatedAt])
}

/// تاریخچه قیمت هر ردیف — هر تغییر قیمت یک ردیف؛ منبع نمودار نوسان قیمت
model PriceHistory {
  id          String    @id @default(cuid())
  priceItemId String
  priceItem   PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  price       Int
  recordedAt  DateTime  @default(now())

  @@index([priceItemId, recordedAt])
}

/// تصاویر آپلودی — در همان دیتابیس مشترک ذخیره می‌شوند تا روی هر سروری (محلی، سرور اصلی، بعد از هر دیپلوی) در دسترس باشند.
/// قبلاً روی دیسک همان سروری ذخیره می‌شد که آپلود را گرفته بود و روی سرور دیگر ۴۰۴ می‌شد.
model Media {
  id           String   @id @default(cuid())
  data         Bytes
  mime         String
  size         Int
  width        Int?
  height       Int?
  originalName String   @default("")
  createdAt    DateTime @default(now())
}

/// پیش‌فاکتور — درخواست مشتری یا صدور ادمین؛ قیمت‌ها اسنپ‌شات می‌شوند
model Quote {
  id              String      @id @default(cuid())
  /// شماره نمایشی مثل Q-1404-0001
  number          String      @unique
  /// توکن تصادفی برای لینک عمومی /q/[token]
  token           String      @unique
  status          QuoteStatus @default(REQUESTED)
  customerName    String
  customerPhone   String
  customerEmail   String      @default("")
  customerCompany String      @default("")
  customerMessage String      @default("")
  /// یادداشت داخلی ادمین — روی پیش‌فاکتور عمومی نیست
  adminNote       String      @default("")
  sourcePath      String?
  /// نرخ مالیات بر ارزش افزوده به درصد (پیش‌فرض ۱۰)
  vatRate         Float       @default(10)
  subtotal        Int         @default(0)
  vatAmount       Int         @default(0)
  total           Int         @default(0)
  /// اعتبار پیش‌فاکتور صادرشده؛ قبل از صدور می‌تواند null باشد
  validUntil      DateTime?
  issuedAt        DateTime?
  /// پیگیری سفارش بعد از صدور فاکتور: '' | PREPARING | LOADING | SHIPPED | DELIVERED (lib/order-status.ts)
  orderStatus     String      @default("")
  /// تاریخچه مراحل برای خط زمانی صفحه پیگیری: JSON [{ status, at }]
  orderLog        String      @default("[]")
  /// توضیح عمومی برای مشتری (مثلاً پلاک یا شماره راننده) — برخلاف adminNote روی صفحه پیگیری دیده می‌شود
  trackingNote    String      @default("")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  priceItemId String?
  productId   String?
  title       String
  /// قیمت واحد اسنپ‌شات‌شده (تومان)
  unitPrice   Int
  /// مقدار به واحد (معمولاً متر)
  quantity    Float
  unit        String  @default("متر")
  lineTotal   Int
  note        String  @default("")
  sortOrder   Int     @default(0)

  @@index([quoteId, sortOrder])
}

enum QuoteStatus {
  DRAFT
  REQUESTED
  ISSUED
  REJECTED
  EXPIRED
}
